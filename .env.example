PORT=3000
PUBLIC_BASE_URL=https://your-domain.example

# Meta / WhatsApp Business Platform
META_GRAPH_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_PHONE_E164=+YOUR_E164_NUMBER
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Supabase (server-side only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=

# MCP OAuth resource-server configuration.
# Recommended: the dedicated Supabase project's OAuth 2.1 server.
OAUTH_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
OAUTH_AUDIENCE=authenticated
OAUTH_JWKS_URI=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
OAUTH_REQUIRED_SCOPES=email
# Fail-closed owner allow-list for this private inbox connector.
OAUTH_ALLOWED_EMAILS=owner@example.com

# Development-only escape hatch. Never set in production.
DEV_BEARER_TOKEN=
ALLOW_INSECURE_NOAUTH=false

# Operational policy
PRIORITY_EVENT_MIN_SCORE=75
MAX_SEARCH_RESULTS=50
