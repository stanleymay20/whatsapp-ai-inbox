PORT=3000
PUBLIC_BASE_URL=https://your-domain.example

# Meta / WhatsApp Business Platform
META_GRAPH_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_PHONE_E164=+YOUR_E164_NUMBER
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Supabase (server-side only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=

# MCP OAuth resource-server configuration (recommended: Auth0 or another OAuth 2.1 provider)
OAUTH_ISSUER=https://YOUR_TENANT.example.com/
OAUTH_AUDIENCE=https://your-domain.example
OAUTH_JWKS_URI=
OAUTH_REQUIRED_SCOPES=whatsapp.read whatsapp.write

# Development-only escape hatch. Never set in production.
DEV_BEARER_TOKEN=
ALLOW_INSECURE_NOAUTH=false

# Operational policy
PRIORITY_EVENT_MIN_SCORE=75
MAX_SEARCH_RESULTS=50
